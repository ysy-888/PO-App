# ── Supabase ──────────────────────────────────────────────────
# Found in Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service-role key (never the anon key) — server-side only, never commit
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
# JWT secret from Supabase → Project Settings → API → JWT Settings.
# Lets the API verify session tokens locally instead of a network call
# to Supabase Auth on every request. Optional but strongly recommended.
SUPABASE_JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────
# The GitHub Pages origin (or localhost during dev) that is allowed to call this API.
# Separate multiple origins with a comma.
ALLOWED_ORIGIN=https://ysy-888.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

# ── Server ────────────────────────────────────────────────────
PORT=4000

# ── Google Calendar + Drive (optional) ────────────────────────
# Preferred: OAuth as a real account (e.g. shipping@). Create a "Desktop app"
# OAuth client (console → APIs & Services → Credentials), put its ID/secret
# here, then run `node scripts/google-oauth-setup.mjs` to mint the refresh
# token. Enable the Calendar API and Drive API for the project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Fallback: service-account JSON key (raw JSON or base64). Used only when the
# OAuth vars above are not all set. Share the calendar ("Make changes to
# events") and Drive folder ("Editor") with the key's client_email.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Calendar that receives CXL/EXF/Pickup/Delivery date events.
# Found in Google Calendar → calendar Settings → Integrate calendar.
# (For OAuth as the calendar's owner, "primary" also works.)
GOOGLE_CALENDAR_ID=
# Drive folder that receives generated packing-list PDFs (ID from the folder URL).
GOOGLE_DRIVE_FOLDER_ID=

# ── Email ─────────────────────────────────────────────────────
# Standalone email-relay Apps Script (deploy from shipping@elevatordisco.com).
# See email-relay/README.md for setup.
APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
# Shared secret from setupEmailRelayToken() in the email-relay project (required).
APPS_SCRIPT_EMAIL_TOKEN=
