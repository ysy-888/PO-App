# ── Supabase ──────────────────────────────────────────────────
# Found in Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service-role key (never the anon key) — server-side only, never commit
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
# JWT secret from Supabase → Project Settings → API → JWT Settings.
# Lets the API verify session tokens locally instead of a network call
# to Supabase Auth on every request. Optional but strongly recommended.
SUPABASE_JWT_SECRET=

# ── CORS ──────────────────────────────────────────────────────
# The GitHub Pages origin (or localhost during dev) that is allowed to call this API.
# Separate multiple origins with a comma.
ALLOWED_ORIGIN=https://ysy-888.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

# ── Server ────────────────────────────────────────────────────
PORT=4000

# ── Email ─────────────────────────────────────────────────────
# Standalone email-relay Apps Script (deploy from shipping@elevatordisco.com).
# See email-relay/README.md for setup.
APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
# Shared secret from setupEmailRelayToken() in the email-relay project (required).
APPS_SCRIPT_EMAIL_TOKEN=
